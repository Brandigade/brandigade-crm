# Brandigade CRM environment variables.
#
# Copy this file to `.env` and fill in the values. `.env` is git-ignored and
# must never be committed. In production the same names are set as Vercel
# Environment Variables (Project Settings -> Environment Variables).
#
# Only SUPABASE_URL and SUPABASE_ANON_KEY are ever sent to the browser (they are
# public by design; row level security protects the data). Every other value is
# read only by the server code in api/ and lib/server/.

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# Public address of the app, without a trailing slash. Used for OAuth redirect
# URIs, Twilio webhook URLs and links inside notification emails.
#   local:      http://localhost:3000
#   production: https://brandigade-crm.vercel.app
APP_URL=http://localhost:3000
APP_NAME=Brandigade CRM

# ---------------------------------------------------------------------------
# Supabase  (Project Settings -> API, or `supabase projects api-keys`)
# ---------------------------------------------------------------------------
SUPABASE_URL=https://wqdysxpormmxxaakfgtu.supabase.co
SUPABASE_PROJECT_REF=wqdysxpormmxxaakfgtu
# Public "anon" key. Safe to ship to the browser.
SUPABASE_ANON_KEY=
# SERVER ONLY. Bypasses row level security. Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
# 32 random bytes, base64. Encrypts stored Gmail/Outlook tokens (AES-256-GCM).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Changing it later disconnects every mailbox (users simply reconnect).
TOKEN_ENCRYPTION_KEY=
# Random string (32+ chars). Supabase's scheduler sends it to /api/cron/tick,
# and Vercel's daily cron sends it as a Bearer token.
# Generate: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=

# ---------------------------------------------------------------------------
# Gmail  (Google Cloud Console -> APIs & Services)
# Enable the Gmail API, configure the OAuth consent screen, then create an
# OAuth client of type "Web application" with these Authorized redirect URIs:
#   http://localhost:3000/api/email/oauth/google/callback
#   https://brandigade-crm.vercel.app/api/email/oauth/google/callback
# Scopes requested: openid, email, gmail.readonly, gmail.send
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Outlook / Microsoft 365  (Microsoft Entra admin center -> App registrations)
# Supported account types: any organizational directory + personal accounts.
# Platform "Web" with these redirect URIs:
#   http://localhost:3000/api/email/oauth/microsoft/callback
#   https://brandigade-crm.vercel.app/api/email/oauth/microsoft/callback
# Delegated API permissions: openid, email, offline_access, User.Read, Mail.Read, Mail.Send
# ---------------------------------------------------------------------------
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# "common" allows work/school and personal accounts. Use your tenant ID to
# restrict sign-in to your own Microsoft 365 organisation.
MICROSOFT_TENANT_ID=common

# ---------------------------------------------------------------------------
# Notification emails (task assigned, reminders, overdue, daily digest)
# Set ONE sender. The existing CRM already uses a Gmail account with an app
# password (Google Account -> Security -> 2-Step Verification -> App passwords).
# ---------------------------------------------------------------------------
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Alternative sender: https://resend.com (needs a verified sending domain)
RESEND_API_KEY=
# Or any SMTP server (also used locally with the Mailpit catcher on port 57325)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
NOTIFICATION_FROM_EMAIL=Brandigade CRM <crm@brandigade.com>

# ---------------------------------------------------------------------------
# Calling  (Twilio Console: https://console.twilio.com)
#   Account SID + Auth Token: Console home page ("Account Info")
#   API key: Account -> API keys & tokens -> Create API key (Standard)
#   Caller ID: a Twilio phone number with Voice capability, in E.164 format
#   TwiML App: created for you by `npm run setup:twilio`, or create one under
#              Voice -> TwiML Apps with Voice URL https://brandigade-crm.vercel.app/api/voice/outbound
# ---------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_TWIML_APP_SID=
TWILIO_CALLER_ID=
